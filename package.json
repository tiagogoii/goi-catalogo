{
  "name": "goi-catalogo",
  "private": true,
  "version": "2.0.0",
  "description": "Catálogo de motos Honda de GOI S.A. con panel de administración",
  "scripts": {
    "dev": "wrangler pages dev public --port 8789",
    "db:local": "wrangler d1 migrations apply goi-catalogo --local",
    "db:remote": "wrangler d1 migrations apply goi-catalogo --remote",
    "deploy": "wrangler pages deploy public --project-name goi-catalogo",
    "test": "node --test tests/flow.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
